# ===========================
# Server
# ===========================
# Port aplikasi berjalan (default 3001)
PORT=3001

# ===========================
# Database Configuration (PostgreSQL)
# ===========================
# Full connection string for PostgreSQL
DATABASE_URL=postgres://your_username:your_password@your_host:23150/your_db?sslmode=require

# Individual DB connection parts (optional, use if needed separately)
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=your_host
DB_PORT=23150
DB_NAME=your_db

# Set true jika koneksi PostgreSQL membutuhkan SSL
DB_SSL=false

# ===========================
# JWT Authentication
# ===========================
# Kunci signing access token (WAJIB, jangan commit nilai asli)
JWT_SECRET=your_jwt_secret
# Kunci signing refresh token (WAJIB, jangan commit nilai asli)
JWT_REFRESH_SECRET=your_jwt_refresh_secret
# Durasi access token (contoh: 15m)
JWT_ACCESS_EXP=15m
# Durasi refresh token dalam hari (contoh: 30)
JWT_REFRESH_EXP_DAYS=30

# ===========================
# Swagger Docs
# ===========================
# Swagger server base URL
SWAGGER_SERVER_URL=http://localhost:3001

# ===========================
# Hyperbase Config (Backend-as-a-Service / ScyllaDB)
# ===========================
# Base URL Hyperbase
HYPERBASE_HOST=https://your_hyperbase_host
# Kredensial login Hyperbase (untuk mendapatkan auth token)
HYPERBASE_EMAIL=your_hyperbase_email
HYPERBASE_PASSWORD=your_hyperbase_password
# Target project & collection Hyperbase
HYPERBASE_PROJECT_ID=your_project_id
HYPERBASE_COLLECTION_ID=your_collection_id
# Bucket gambar Hyperbase
HYPERBASE_BUCKET_ID=your_bucket_id

# ===========================
# MQTT Broker Config
# ===========================
MQTT_BROKER_URL=ws://your_broker_ip:port/mqtt
MQTT_TOPIC=your_topic

# ===========================
# Email (Nodemailer - verifikasi)
# ===========================
GMAIL_USER=your_gmail_user
GMAIL_PASS=your_gmail_app_password

# ===========================
# Google OAuth2 (Login provider)
# ===========================
# redirect_uri dikirim oleh client melalui request body, tidak perlu di-set di server
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
